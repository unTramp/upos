{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upos:schema:meta:schema-registry:0.1.0",
  "title": "U-POS Schema Registry",
  "description": "Machine-readable index of U-POS schemas. This registry is not a semantic owner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "upos_baseline",
    "entries"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "upos_baseline": {
      "type": "string",
      "const": "v1.0.0"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_key",
        "schema_version",
        "artifact_path",
        "implementation_state",
        "upos_baseline",
        "schema_owner_module",
        "normative_source_refs",
        "identity_model",
        "reference_dependencies",
        "instance_compatibility",
        "semantic_compatibility",
        "notes"
      ],
      "properties": {
        "schema_key": {
          "type": "string",
          "pattern": "^upos\\.(common|0[1-9]|1[01])\\.[a-z0-9_.-]+$"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "artifact_path": {
          "type": "string",
          "pattern": "^schemas/.+\\.schema\\.json$"
        },
        "implementation_state": {
          "enum": ["DRAFT", "CANDIDATE", "STABLE", "DEPRECATED", "RETIRED"]
        },
        "upos_baseline": {
          "type": "string",
          "const": "v1.0.0"
        },
        "schema_owner_module": {
          "type": "string",
          "pattern": "^(COMMON|UPOS-0[1-9]|UPOS-1[01])$"
        },
        "normative_source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "identity_model": {
          "type": "string",
          "minLength": 1
        },
        "reference_dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^upos\\.(common|0[1-9]|1[01])\\.[a-z0-9_.-]+$"
          }
        },
        "instance_compatibility": {
          "enum": [
            "INITIAL",
            "BACKWARD_INSTANCE_COMPATIBLE",
            "FORWARD_INSTANCE_COMPATIBLE",
            "FULL_INSTANCE_COMPATIBLE",
            "BREAKING_OR_MIXED"
          ]
        },
        "semantic_compatibility": {
          "enum": ["INITIAL", "COMPATIBLE", "BREAKING", "REQUIRES_OWNER_REVIEW"]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
