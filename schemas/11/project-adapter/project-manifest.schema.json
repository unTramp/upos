{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upos:schema:11:project-adapter:project-manifest:0.1.0",
  "title": "U-POS Project Manifest",
  "description": "Machine-readable representation of the frozen UPOS-011 Project Manifest top-level contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "upos_baseline",
    "manifest_version",
    "project_adapter_version",
    "repositories",
    "paths",
    "commands",
    "providers",
    "runtime",
    "environments",
    "identity_bindings",
    "resource_bindings",
    "capability_bindings",
    "security_bindings",
    "secret_bindings",
    "quality_bindings",
    "observability_bindings",
    "learning_bindings",
    "extensions"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "name", "canonical_project_source_ref"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "canonical_project_source_ref": {"type": "string", "minLength": 1}
      }
    },
    "upos_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "module_interface_requirements"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "module_interface_requirements": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "manifest_version": {"type": "string", "minLength": 1},
    "project_adapter_version": {"type": "string", "minLength": 1},
    "repositories": {
      "$ref": "#/$defs/repositoryDeclarationsOrNA"
    },
    "paths": {"$ref": "#/$defs/refListOrNA"},
    "commands": {"$ref": "#/$defs/refListOrNA"},
    "providers": {"$ref": "#/$defs/providerDeclarationsOrNA"},
    "runtime": {
      "oneOf": [
        {"const": "N/A"},
        {"type": "object"}
      ]
    },
    "environments": {"$ref": "#/$defs/refListOrNA"},
    "identity_bindings": {"$ref": "#/$defs/refListOrNA"},
    "resource_bindings": {"$ref": "#/$defs/refListOrNA"},
    "capability_bindings": {"$ref": "#/$defs/refListOrNA"},
    "security_bindings": {"$ref": "#/$defs/refListOrNA"},
    "secret_bindings": {"$ref": "#/$defs/refListOrNA"},
    "quality_bindings": {"$ref": "#/$defs/refListOrNA"},
    "observability_bindings": {"$ref": "#/$defs/refListOrNA"},
    "learning_bindings": {"$ref": "#/$defs/refListOrNA"},
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_.-]*$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "refListOrNA": {
      "oneOf": [
        {"const": "N/A"},
        {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      ]
    },
    "repositoryDeclarationsOrNA": {
      "oneOf": [
        {"const": "N/A"},
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository_ref", "binding_id"],
            "properties": {
              "repository_ref": {"type": "string", "minLength": 1},
              "binding_id": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "providerDeclarationsOrNA": {
      "oneOf": [
        {"const": "N/A"},
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider_adapter_ref", "provider_adapter_version"],
            "properties": {
              "provider_adapter_ref": {"type": "string", "minLength": 1},
              "provider_adapter_version": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
