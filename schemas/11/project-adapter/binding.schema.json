{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upos:schema:11:project-adapter:binding:0.1.0",
  "title": "U-POS Generic Binding",
  "description": "Machine-readable representation of the frozen UPOS-011 Generic Binding contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "binding_type",
    "version",
    "status",
    "abstract_requirement_ref",
    "scope",
    "concrete_target_ref",
    "provider_adapter_ref",
    "provider_adapter_version",
    "configuration_ref",
    "canonical_policy_ref",
    "security_policy_ref",
    "requiredness",
    "effective_from",
    "expires_at",
    "validation_state",
    "compatibility_state",
    "health_state",
    "supersedes",
    "replacement"
  ],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1},
    "binding_type": {
      "oneOf": [
        {
          "enum": [
            "REPOSITORY_BINDING",
            "PATH_BINDING",
            "COMMAND_BINDING",
            "TOOL_BINDING",
            "PROVIDER_BINDING",
            "IDENTITY_BINDING",
            "RESOURCE_BINDING",
            "CAPABILITY_BINDING",
            "ENVIRONMENT_BINDING",
            "SECRET_BINDING",
            "QUALITY_BINDING",
            "OBSERVABILITY_BINDING",
            "LEARNING_BINDING",
            "APPROVAL_BINDING"
          ]
        },
        {
          "type": "string",
          "pattern": "^extensions\\.[a-z0-9][a-z0-9_.-]+$"
        }
      ]
    },
    "version": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["DRAFT", "ACTIVE", "DEPRECATED", "RETIRED", "SUPERSEDED"]
    },
    "abstract_requirement_ref": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "repository_ref",
        "environment_ref",
        "operation_ref"
      ],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "repository_ref": {"type": "string", "minLength": 1},
        "environment_ref": {"type": "string", "minLength": 1},
        "operation_ref": {"type": "string", "minLength": 1}
      }
    },
    "concrete_target_ref": {"type": "string", "minLength": 1},
    "provider_adapter_ref": {"type": "string", "minLength": 1},
    "provider_adapter_version": {"type": "string", "minLength": 1},
    "configuration_ref": {"type": "string", "minLength": 1},
    "canonical_policy_ref": {"type": "string", "minLength": 1},
    "security_policy_ref": {"type": "string", "minLength": 1},
    "requiredness": {
      "enum": ["REQUIRED", "OPTIONAL", "CONDITIONAL"]
    },
    "effective_from": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "validation_state": {
      "enum": ["VALID", "VALID_WITH_WARNINGS", "INCOMPLETE", "INVALID"]
    },
    "compatibility_state": {"type": "string", "minLength": 1},
    "health_state": {"type": "string", "minLength": 1},
    "supersedes": {"type": "string", "minLength": 1},
    "replacement": {"type": "string", "minLength": 1}
  }
}
