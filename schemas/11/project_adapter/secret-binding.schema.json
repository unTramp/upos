{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upos:schema:11:project-adapter:secret-binding:0.1.0",
  "title": "U-POS Secret Store Binding",
  "allOf": [
    {
      "$ref": "urn:upos:schema:11:project-adapter:binding:0.1.0#/$defs/core"
    },
    {
      "type": "object",
      "required": [
        "binding_type",
        "secret_ref",
        "secret_store_adapter_ref",
        "secret_store_adapter_version",
        "provider_secret_identifier_ref",
        "allowed_use_mode",
        "injection_mechanism_ref",
        "environment_scope"
      ],
      "properties": {
        "binding_type": {
          "const": "SECRET_BINDING"
        },
        "secret_ref": {
          "type": "string",
          "minLength": 1
        },
        "secret_store_adapter_ref": {
          "type": "string",
          "minLength": 1
        },
        "secret_store_adapter_version": {
          "type": "string",
          "minLength": 1
        },
        "provider_secret_identifier_ref": {
          "type": "string",
          "minLength": 1
        },
        "allowed_use_mode": {
          "enum": [
            "USE_WITHOUT_DISCLOSURE",
            "REFERENCE_ONLY",
            "DISCLOSE_TO_AUTHORIZED_TOOL"
          ]
        },
        "injection_mechanism_ref": {
          "type": "string",
          "minLength": 1
        },
        "environment_scope": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
