{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:upos:schema:04:workflow:workflow-instance-runtime:0.1.0",
  "title": "UPOS-04 Workflow Instance Runtime",
  "description": "Phase-3 runtime representation of Workflow Instance and Stage state with expected-state transition preconditions. It does not execute transitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_instance_ref",
    "task_ref",
    "routing_decision_ref",
    "workflow_definition_id",
    "workflow_version",
    "current_state",
    "stages"
  ],
  "properties": {
    "runtime_contract_ref": {
      "const": "UPOS-04-WORKFLOW-INSTANCE-RUNTIME"
    },
    "runtime_contract_version": {
      "const": "0.1.0"
    },
    "runtime_schema_version": {
      "const": "0.1.0"
    },
    "workflow_instance_ref": {
      "$ref": "urn:upos:schema:04:workflow:identity-references:0.1.0#/$defs/workflowInstanceRef"
    },
    "task_ref": {
      "$ref": "urn:upos:schema:04:workflow:identity-references:0.1.0#/$defs/taskRef"
    },
    "routing_decision_ref": {
      "$ref": "urn:upos:schema:04:workflow:identity-references:0.1.0#/$defs/routingDecisionRef"
    },
    "workflow_definition_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_version": {
      "type": "string",
      "minLength": 1
    },
    "current_state": {
      "$ref": "#/$defs/workflowState"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stageRuntime"
      }
    },
    "transition_request": {
      "$ref": "#/$defs/workflowTransitionRequest"
    }
  },
  "$defs": {
    "workflowState": {
      "enum": [
        "READY",
        "RUNNING",
        "PAUSED",
        "BLOCKED",
        "REWORK_REQUIRED",
        "ESCALATED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "SUPERSEDED"
      ]
    },
    "stageState": {
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "BLOCKED",
        "COMPLETED",
        "SKIPPED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "stageRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_ref",
        "current_state"
      ],
      "properties": {
        "stage_ref": {
          "$ref": "urn:upos:schema:04:workflow:identity-references:0.1.0#/$defs/stageRef"
        },
        "current_state": {
          "$ref": "#/$defs/stageState"
        },
        "blocking_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependency_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:upos:schema:04:workflow:identity-references:0.1.0#/$defs/stageRef"
          }
        },
        "transition_request": {
          "$ref": "#/$defs/stageTransitionRequest"
        }
      }
    },
    "workflowTransitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_ref",
        "expected_current_state",
        "requested_state",
        "transition_basis_ref"
      ],
      "properties": {
        "transition_ref": {
          "$ref": "urn:upos:schema:04:workflow:identity-references:0.1.0#/$defs/transitionRef"
        },
        "expected_current_state": {
          "$ref": "#/$defs/workflowState"
        },
        "requested_state": {
          "$ref": "#/$defs/workflowState"
        },
        "transition_basis_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stageTransitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_ref",
        "expected_current_state",
        "requested_state",
        "transition_basis_ref"
      ],
      "properties": {
        "transition_ref": {
          "$ref": "urn:upos:schema:04:workflow:identity-references:0.1.0#/$defs/transitionRef"
        },
        "expected_current_state": {
          "$ref": "#/$defs/stageState"
        },
        "requested_state": {
          "$ref": "#/$defs/stageState"
        },
        "transition_basis_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
